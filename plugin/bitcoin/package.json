{
  "name": "reactive-md-bitcoin-component-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A <bitcoin> component for ReactiveMD with a Binance BTC/USDT WebSocket host channel.",
  "scripts": {
    "dev": "vite --config vite.config.ts",
