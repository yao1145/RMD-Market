    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "reactive-md": "^0.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.0",
    "vite": "^8.3.5"
  }
}